{
    "name": "dotnet-format-plus",
    "version": "0.0.0",
    "private": true,
    "description": "yet another dotnet-format action",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc --noEmit",
        "format": "biome format --write .",
        "format-check": "biome check .",
        "lint": "biome lint .",
        "package": "ncc build src/main.ts -o dist --source-map",
        "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test \"__tests__/**/*.test.ts\"",
        "test:w": "node --experimental-transform-types --disable-warning=ExperimentalWarning --watch --test \"__tests__/**/*.test.ts\"",
        "copy-matcher": "node scripts/finalize-dist.mjs",
        "all": "pnpm run build && pnpm run format-check && pnpm run package && pnpm run test && pnpm run copy-matcher"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/actions/typescript-action.git"
    },
    "keywords": [
        "actions",
        "github actions"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@actions/artifact": "^2.2.1",
        "@actions/core": "^1.10.1",
        "@actions/exec": "^1.1.1",
        "@actions/github": "^6.0.0",
        "@actions/io": "^3.0.2",
        "@octokit/rest": "^22.0.1",
        "deepmerge": "4.3.1",
        "js-yaml": "^4.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.1",
        "@octokit/types": "^16.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.13.2",
        "@vercel/ncc": "^0.44.0",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@11.9.0"
}
